---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Carnet from '../components/Carnet.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import { club, grups, etapes, valors, generesNom, nascuts } from '../data/club';
import fotoEscola from '../assets/fotos/canovelles-blue-3.jpg';
import fotoFamilia from '../assets/fotos/canovelles-fotofamilia-1.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tints = ['butter', 'mint', 'sky'] as const;
---

<Base>
  <a class="skip" href="#principal">Salta al contingut</a>
  <SiteHeader />

  <main id="principal">
    <!-- First viewport: the club card -->
    <section class="hero page" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 id="hero-title">El seu primer carnet de bàsquet.</h1>
        <p class="hero__lede">Escriu-hi el nom i l’any de naixement i mira quin grup li toca.</p>
        <p class="hero__where">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></svg>
          {club.adreca.pavello}
        </p>
      </div>

      <form class="hero__card" id="carnet" novalidate>
        <Carnet />
        <div class="hero__actions">
          <a class="btn btn--ink" id="hero-cta" href={`${base}/preinscripcio/`}>
            Fes la preinscripció
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
          <button class="btn btn--sky" type="button" data-flip="carnet" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 9M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6L4 15M4 20v-5h5" /></svg>
            <span data-flip-text>Gira el carnet</span>
          </button>
        </div>
      </form>
    </section>

    <!-- Groups -->
    <section class="groups" id="grups" aria-labelledby="grups-title">
      <div class="page">
        <div class="groups__head">
          <h2 id="grups-title">Un grup per a cada edat</h2>
          <p>Tots els equips del club han crescut a l’escola. Anys orientatius per a la temporada {club.temporada}.</p>
        </div>

        {
          etapes.map((e) => (
            <div class="stage">
              <div class="stage__name">
                <h3>{e.nom}</h3>
                <p>{e.text}</p>
              </div>
              <ul class="stage__rows">
                {grups
                  .filter((g) => (e.grups as readonly string[]).includes(g.nom))
                  .map((g) => (
                    <li class="row" id={`grup-${g.num}`}>
                      <span class="row__name">{g.nom}</span>
                      <span class="row__years">{nascuts(g.anys)}</span>
                      <span class="row__teams">{g.equips.map((id) => generesNom[id]).join(' · ')}</span>
                      <span class="row__note">{g.nota}</span>
                      <span class="row__tag" aria-hidden="true">El seu grup</span>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Where -->
    <section class="where page" id="pavello" aria-labelledby="pavello-title">
      <figure class="print where__photo">
        <Image src={fotoEscola} alt="Una entrenadora dibuixa una jugada en una pissarra davant d’un grup de nens i nenes" widths={[480, 800]} sizes="(max-width: 860px) 100vw, 46vw" />
      </figure>
      <div class="where__copy">
        <h2 id="pavello-title">On entrenem i juguem</h2>
        <address class="where__address">
          <span class="where__place">{club.adreca.pavello}</span>
          <span>{club.adreca.carrer}, {club.adreca.cp} {club.adreca.poblacio}</span>
        </address>
        <a class="link" href={club.adreca.mapa} rel="noopener">
          Obre el mapa
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </a>
        <dl class="where__facts">
          <div>
            <dt class="label">Horaris i quotes</dt>
            <dd>Depenen del grup. Te’ls expliquem quan rebem la preinscripció.</dd>
          </div>
          <div>
            <dt class="label">Dubtes</dt>
            <dd><a href={`mailto:${club.correus.general}`}>{club.correus.general}</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Club -->
    <section class="club" id="club" aria-labelledby="club-title">
      <div class="page">
        <div class="club__head">
          <h2 id="club-title">Som club, som família</h2>
          <p>
            Jugem a Canovelles des del {club.fundacio}. L’escola va obrir el març del {club.escola} i aquesta temporada en som {club.equips} equips, de l’Escoleta a les veteranes.
          </p>
        </div>
      </div>

      <svg class="visually-hidden" aria-hidden="true" focusable="false">
        <filter id="duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.118 0.902" />
            <feFuncG type="table" tableValues="0.169 0.929" />
            <feFuncB type="table" tableValues="0.353 0.973" />
          </feComponentTransfer>
        </filter>
      </svg>

      <figure class="club__photo page">
        <div class="print print--duotone">
          <Image src={fotoFamilia} alt="Foto de família de tots els equips del club a la grada del pavelló" widths={[640, 1024, 1366]} sizes="(max-width: 1290px) 100vw, 1240px" />
        </div>
        <figcaption>Tot el club en una foto, a la grada del pavelló.</figcaption>
      </figure>

      <div class="club__values page">
        <blockquote class="club__quote">
          <p>Som un club petit, però els nostres jugadors són molt grans.</p>
          <footer>Humilitat, un dels sis valors del club</footer>
        </blockquote>
        <div>
          <h3 class="club__values-title">El que ens fa club</h3>
          <ul class="sheet">
            {
              valors.map((v, i) => (
                <li class="sheet__cell">
                  <span class={`sticker sticker--${tints[i % 3]}`} style={`--tilt: ${[-4, 3, -2, 4, -3, 2][i]}deg`}>
                    {v.nom}
                  </span>
                  {v.nom === 'Humilitat' ? (
                    <span class="sheet__text sheet__text--pointer">
                      <span class="sheet__wide">La frase de l’esquerra.</span>
                      <span class="sheet__narrow">La frase de dalt.</span>
                    </span>
                  ) : (
                    <span class="sheet__text">{v.text}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Close -->
    <section class="close" aria-labelledby="close-title">
      <div class="page close__inner">
        <div class="close__copy">
          <h2 id="close-title">Li fem el carnet?</h2>
          <p>Omple la preinscripció i et responem amb els horaris i la quota del seu grup.</p>
          <a class="btn btn--ink" id="close-cta" href={`${base}/preinscripcio/`}>
            Fes la preinscripció
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <div class="close__card" aria-hidden="true">
          <Carnet mode="preview" uid="carnet-tancament" nameSrc="carnet-nom" yearSrc="carnet-any" />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<script>
  // Card → groups list and the hero button follow what the visitor typed.
  const ctas = ['hero-cta', 'close-cta'].map((id) => document.getElementById(id) as HTMLAnchorElement);
  const baseHref = ctas[0]!.getAttribute('href')!;
  document.getElementById('carnet')!.addEventListener('carnet:update', (e) => {
    const { name, year, grup } = (e as CustomEvent).detail;
    document.querySelectorAll('.row.is-match').forEach((r) => r.classList.remove('is-match'));
    if (grup) document.getElementById(`grup-${grup.num}`)?.classList.add('is-match');
    const q = new URLSearchParams();
    if (name) q.set('nom', name);
    if (year.length === 4) q.set('any', year);
    if (grup) q.set('grup', grup.nom);
    ctas.forEach((a) => (a.href = q.size ? `${baseHref}?${q}` : baseHref));
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    min-height: min(calc(100svh - 76px), 860px);
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 6vw, 88px);
  }

  .hero h1 {
    font-size: clamp(44px, 5.6vw, 84px);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .hero__lede {
    margin-top: clamp(20px, 2vw, 28px);
    max-width: 34ch;
    font-size: clamp(18px, 1.45vw, 21px);
    color: var(--ink-soft);
  }

  .hero__where {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 16px;
    font-weight: 700;
  }

  .hero__where svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .hero__card {
    display: grid;
    gap: clamp(24px, 3vw, 36px);
    justify-items: center;
  }

  .hero__card :global(.carnet) {
    max-width: 680px;
    rotate: -3deg;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .hero__actions svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Groups ---------- */
  .groups {
    padding-block: clamp(64px, 8vw, 120px);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0) 30%),
      var(--sky);
  }

  .groups__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 48px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .groups__head h2,
  .where h2,
  .club h2 {
    font-size: clamp(36px, 4.4vw, 64px);
    letter-spacing: -0.03em;
  }

  .groups__head p {
    max-width: 42ch;
    color: var(--ink-soft);
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 16px 48px;
    padding-block: 28px;
    border-top: 2px solid var(--ink);
  }

  .stage__name h3 {
    font-size: clamp(26px, 2.4vw, 34px);
    letter-spacing: -0.02em;
  }

  .stage__name p {
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 24ch;
  }

  .stage__rows {
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3.2fr) minmax(0, 1.6fr) minmax(0, 2fr) minmax(0, 4fr);
    gap: 4px 24px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--sky-deep);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row__name {
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.015em;
    transition: font-weight 0.5s var(--ease-out);
  }

  .row__years {
    font-weight: 700;
  }

  .row__teams,
  .row__note {
    font-size: 16px;
    color: var(--ink-soft);
  }

  .row__tag {
    position: absolute;
    right: 0;
    top: 50%;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--butter);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 4px 10px -4px rgb(36 67 95 / 0.35);
    opacity: 0;
    transform: translateY(-50%) scale(1.3) rotate(-8deg);
    transition: opacity 0.3s var(--ease-out), transform 0.5s var(--ease-out);
    pointer-events: none;
  }

  .row.is-match .row__name {
    font-weight: 800;
  }

  .row.is-match .row__tag {
    opacity: 1;
    transform: translateY(-50%) rotate(-4deg);
  }

  .row.is-match .row__note {
    padding-right: 120px;
  }

  /* ---------- Where ---------- */
  .where {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(72px, 9vw, 136px);
  }

  .where__photo {
    aspect-ratio: 5 / 4;
  }

  .where__address {
    display: grid;
    gap: 4px;
    margin: clamp(24px, 3vw, 36px) 0 16px;
    font-style: normal;
    font-size: 19px;
  }

  .where__place {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.3vw, 32px);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .where__facts {
    display: grid;
    gap: 20px;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--sky-deep);
  }

  .where__facts dd {
    margin-top: 4px;
  }

  /* ---------- Club ---------- */
  .club {
    padding-bottom: clamp(72px, 9vw, 136px);
  }

  .club__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 20px 48px;
    align-items: end;
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 2px solid var(--ink);
  }

  .club__head p {
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .club__photo {
    margin-block: clamp(36px, 4vw, 56px) 0;
  }

  .club__photo .print {
    aspect-ratio: 16 / 8;
  }

  .club__photo figcaption {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-soft);
  }

  .club__values {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(32px, 6vw, 96px);
    margin-top: clamp(56px, 7vw, 104px);
  }

  .club__quote {
    margin: 0;
  }

  .club__quote p {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.3vw, 48px);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .club__quote footer {
    margin-top: 16px;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .print--duotone img {
    filter: url(#duotone);
  }

  .club__values-title {
    font-size: 22px;
    margin-bottom: 20px;
  }

  /* One sticker sheet: die-cut stickers on a single backing, captions printed on it */
  .sheet {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--corner);
    background: #f8fbfd;
    box-shadow: var(--shadow-card);
  }

  .sheet__text--pointer {
    font-style: italic;
  }

  .sheet__narrow {
    display: none;
  }

  @media (max-width: 960px) {
    .sheet__wide {
      display: none;
    }

    .sheet__narrow {
      display: inline;
    }
  }

  .sheet__cell {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
    padding-inline: 4px;
  }

  .sticker {
    display: inline-block;
    padding: 9px 16px 10px;
    border: 4px solid #fff;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.1;
    rotate: var(--tilt);
    box-shadow: 0 1px 1px rgb(36 67 95 / 0.12), 0 4px 10px -4px rgb(36 67 95 / 0.35);
    transition: rotate 0.4s var(--ease-out), translate 0.4s var(--ease-out);
  }

  .sheet__cell:hover .sticker {
    rotate: 0deg;
    translate: 0 -2px;
  }

  .sheet__text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .sticker--butter {
    background: var(--butter);
  }

  .sticker--mint {
    background: var(--mint);
  }

  .sticker--sky {
    background: var(--sky);
  }

  /* ---------- Close: the card comes back ---------- */
  .close {
    padding-block: clamp(72px, 9vw, 128px);
    background: var(--sky-soft);
    overflow: hidden;
  }

  .close__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .close__copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .close h2 {
    font-size: clamp(40px, 5vw, 72px);
    letter-spacing: -0.035em;
  }

  .close p {
    max-width: 40ch;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  .close__card :global(.carnet) {
    max-width: 480px;
    rotate: 4deg;
  }

  .close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .close__inner {
      grid-template-columns: 1fr;
    }

    .close__card :global(.carnet) {
      max-width: 400px;
      margin-inline: auto;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 36px;
    }

    .hero__card :global(.carnet) {
      rotate: -2deg;
    }

    .groups__head,
    .club__head,
    .club__values,
    .where {
      grid-template-columns: 1fr;
    }

    .stage {
      grid-template-columns: 1fr;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .row__teams,
    .row__note {
      grid-column: 1 / -1;
    }

    .row__years {
      text-align: right;
    }

    .row.is-match .row__note {
      padding-right: 0;
    }

    .row__tag {
      top: 14px;
      right: auto;
      left: auto;
      position: static;
      grid-column: 1 / -1;
      justify-self: start;
      display: none;
    }

    .row.is-match .row__tag {
      display: block;
      transform: rotate(-3deg);
      margin-top: 6px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 24px;
    }

    .hero__actions {
      display: grid;
      width: 100%;
    }

    .club__photo .print {
      aspect-ratio: 4 / 3;
    }

    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .close__card :global(.carnet) {
      width: calc(100% - 24px);
      rotate: 2deg;
    }
  }
</style>
