---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import '../../styles/acta.css';
import { club, grups, valors, type Genere } from '../../data/club';
import fotoEscola from '../../assets/fotos/canovelles-blue-3.jpg';
import fotoFamilia from '../../assets/fotos/canovelles-fotofamilia-1.jpg';
import fotoMini from '../../assets/fotos/home-blue-mini.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const generes: { id: Genere; label: string; curt: string }[] = [
  { id: 'masc', label: 'Masculí', curt: 'Masc.' },
  { id: 'fem', label: 'Femení', curt: 'Fem.' },
  { id: 'mixt', label: 'Mixt', curt: 'Mixt' },
];

const nascuts = (anys: [number | null, number | null]) => {
  const [a, b] = anys;
  if (a === null && b === null) return 'Adultes';
  if (a === null) return `${b} o abans`;
  return a === b ? `${a}` : `${a}–${b}`;
};

// Running score column of the acta: 1 to 40, A and B.
const tanteig = Array.from({ length: 40 }, (_, i) => i + 1);
const grupsJson = JSON.stringify(grups.map(({ num, nom, anys }) => ({ num, nom, anys })));
---

<Base title="Plantilla: acta d’inscripció" themeColor="#0f4c4a" noindex>
  <a class="skip" href="#principal">Salta al contingut</a>

  <header class="bar">
    <div class="sheet bar__inner">
      <p class="bar__title">
        <span class="bar__strong">Acta d’inscripció</span>
        <span class="bar__season">Temporada {club.temporada}</span>
      </p>
      <nav aria-label="Seccions">
        <ul class="bar__nav">
          <li><a href="#grups">Grups</a></li>
          <li><a href="#pavello">On entrenem</a></li>
          <li><a href="#club">El club</a></li>
        </ul>
      </nav>
      <a class="btn btn--paper" href="#preinscripcio">Preinscripció</a>
    </div>
  </header>

  <main id="principal">
    <div class="sheet acta">
      <div class="acta__body">
        <!-- Acta header -->
        <section class="head" aria-label="Dades del club">
          <div class="head__seal">
            <img src={`${base}/escut.svg`} alt="Escut del Canovelles Bàsquet Club" width="148" height="133" />
          </div>
          <dl class="head__fields">
            <div class="cell cell--wide">
              <dt>Club</dt>
              <dd class="hand">{club.nom}</dd>
            </div>
            <div class="cell cell--wide">
              <dt>Lloc</dt>
              <dd class="hand">{club.adreca.pavello}</dd>
            </div>
            <div class="cell">
              <dt>Temporada</dt>
              <dd class="hand">{club.temporada}</dd>
            </div>
            <div class="cell">
              <dt>Equips</dt>
              <dd class="hand">{club.equips}</dd>
            </div>
            <div class="cell">
              <dt>Des de</dt>
              <dd class="hand">{club.fundacio}</dd>
            </div>
          </dl>
        </section>

        <!-- First viewport -->
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero__copy">
            <h1 id="hero-title">Falta un nom a l’acta.</h1>
            <p class="hero__lede">Hi ha un grup per a cada edat. Escriu l’any de naixement i et diem quin.</p>

            <form class="finder" id="finder" novalidate>
              <div class="finder__cell">
                <label for="any">Any de naixement</label>
                <input
                  id="any"
                  name="any"
                  class="hand finder__input"
                  inputmode="numeric"
                  autocomplete="off"
                  maxlength="4"
                  pattern="[0-9]{4}"
                  placeholder="2017"
                  aria-describedby="finder-result"
                />
              </div>
              <button class="btn btn--ink finder__go" type="submit">Busca el grup</button>
            </form>
            <p class="finder__result hand" id="finder-result" aria-live="polite"></p>

            <p class="hero__cta">
              <a class="link" href="#preinscripcio">Ja ho tens clar? Passa a la preinscripció</a>
              <a class="link" href="#grups">Mira tots els grups</a>
            </p>
          </div>

          <figure class="photocopy hero__photo">
            <Image src={fotoEscola} alt="Una entrenadora dibuixa una jugada en una pissarra davant d’un grup de nens i nenes" width={640} loading="eager" />
            <figcaption>Pissarra, retolador i ganes d’aprendre.</figcaption>
          </figure>
        </section>

        <!-- Roster -->
        <section class="block" id="grups" aria-labelledby="grups-title">
          <h2 class="block__bar" id="grups-title">Un grup per a cada edat</h2>
          <table class="roster">
            <caption class="visually-hidden">Grups del club per any de naixement i equips de cada grup</caption>
            <thead>
              <tr>
                <th scope="col" class="roster__num">Núm.</th>
                <th scope="col">Grup</th>
                <th scope="col">Nascuts</th>
                {generes.map((g) => <th scope="col" class="roster__g"><abbr title={g.label}>{g.curt}</abbr></th>)}
                <th scope="col" class="roster__obs">Observacions</th>
              </tr>
            </thead>
            <tbody>
              {
                grups.map((g) => (
                  <tr id={`grup-${g.num}`} data-teams={g.equips.map((id) => generes.find((x) => x.id === id)?.label).join(' · ')}>
                    <td class="roster__num">{g.num}</td>
                    <th scope="row" class="roster__name">
                      <span>
                        {g.nom}
                        <svg class="circle" viewBox="0 0 220 60" preserveAspectRatio="none" aria-hidden="true">
                          <path pathLength="1" d="M14 34C10 16 70 6 122 7c56 1 92 10 90 25-2 17-62 23-108 22C52 53 8 47 10 30 12 19 44 11 78 10" />
                        </svg>
                      </span>
                    </th>
                    <td class="roster__years">{nascuts(g.anys)}</td>
                    {generes.map((ge) => (
                      <td class="roster__g" data-label={ge.label}>
                        {g.equips.includes(ge.id) ? (
                          <svg class="tick" viewBox="0 0 24 24" role="img" aria-label="Sí">
                            <path d="M4 13.5l5 5L20.5 5" />
                          </svg>
                        ) : (
                          <span class="visually-hidden">No</span>
                        )}
                      </td>
                    ))}
                    <td class="roster__obs">{g.nota}</td>
                  </tr>
                ))
              }
              <tr class="roster__empty">
                <td class="roster__num">14</td>
                <th scope="row" class="roster__name" colspan="6">
                  <a class="hand hand--red" href="#preinscripcio">El teu fill o filla?</a>
                </th>
              </tr>
            </tbody>
          </table>
          <p class="roster__note">
            Anys orientatius per a la temporada {club.temporada}. Si tens dubtes amb l’edat, pregunta’ns-ho a la preinscripció.
          </p>
        </section>

        <!-- Where -->
        <section class="block" id="pavello" aria-labelledby="pavello-title">
          <h2 class="block__bar" id="pavello-title">On entrenem i juguem</h2>
          <div class="where">
            <div class="where__cells">
              <div class="cell">
                <p class="label">Pavelló</p>
                <p class="hand where__value">{club.adreca.pavello}</p>
              </div>
              <div class="cell">
                <p class="label">Adreça</p>
                <p class="hand where__value">{club.adreca.carrer}, {club.adreca.poblacio}</p>
                <a class="link" href={club.adreca.mapa} rel="noopener">Obre el mapa</a>
              </div>
              <div class="cell">
                <p class="label">Horaris i quotes</p>
                <p class="hand where__value">Segons el grup: t’ho expliquem en rebre la preinscripció.</p>
                <a class="link" href={`mailto:${club.correus.general}`}>{club.correus.general}</a>
              </div>
            </div>
            <figure class="photocopy where__photo">
              <Image src={fotoMini} alt="Un equip de noies escolta l’entrenadora durant un temps mort" width={520} />
              <figcaption>Temps mort.</figcaption>
            </figure>
          </div>
        </section>

        <!-- Club -->
        <section class="block" id="club" aria-labelledby="club-title">
          <h2 class="block__bar" id="club-title">Som club, som família</h2>
          <figure class="photocopy family">
            <Image src={fotoFamilia} alt="Foto de família de tots els equips del club a la grada del pavelló" width={1240} />
            <figcaption>Tot el club en una foto. Tots els equips han crescut a l’escola, oberta des del {club.escola}.</figcaption>
          </figure>
          <div class="values">
            <p class="label values__label">Observacions</p>
            <ul class="values__list hand" aria-label="Valors del club">
              {valors.map((v) => <li title={v.text}>{v.nom}</li>)}
            </ul>
          </div>
        </section>

        <!-- Pre-registration -->
        <section class="block" id="preinscripcio" aria-labelledby="pre-title">
          <h2 class="block__bar" id="pre-title">Preinscripció</h2>
          <form class="signup" id="signup" novalidate>
            <div class="signup__grid">
              <div class="cell field field--wide">
                <label for="f-nom">Nom i cognoms del jugador o jugadora</label>
                <input id="f-nom" name="nom" class="hand" required autocomplete="off" />
                <p class="field__error hand hand--red" id="f-nom-err"></p>
              </div>
              <div class="cell field">
                <label for="f-any">Any de naixement</label>
                <input id="f-any" name="any" class="hand" required inputmode="numeric" maxlength="4" pattern="[0-9]{4}" autocomplete="off" />
                <p class="field__error hand hand--red" id="f-any-err"></p>
              </div>
              <div class="cell field">
                <label for="f-grup">Grup</label>
                <select id="f-grup" name="grup" class="hand">
                  <option value="">Encara no ho sé</option>
                  {grups.map((g) => <option value={g.nom}>{g.nom}</option>)}
                </select>
              </div>
              <div class="cell field field--wide">
                <label for="f-tutor">Nom de la mare, el pare o el tutor</label>
                <input id="f-tutor" name="tutor" class="hand" required autocomplete="name" />
                <p class="field__error hand hand--red" id="f-tutor-err"></p>
              </div>
              <div class="cell field">
                <label for="f-tel">Telèfon</label>
                <input id="f-tel" name="tel" type="tel" class="hand" required autocomplete="tel" />
                <p class="field__error hand hand--red" id="f-tel-err"></p>
              </div>
              <div class="cell field field--wide2">
                <label for="f-mail">Correu electrònic</label>
                <input id="f-mail" name="mail" type="email" class="hand" required autocomplete="email" />
                <p class="field__error hand hand--red" id="f-mail-err"></p>
              </div>
              <div class="cell field field--full">
                <label for="f-obs">Observacions <span class="optional">(opcional)</span></label>
                <textarea id="f-obs" name="obs" class="hand" rows="3"></textarea>
              </div>
            </div>
            <div class="signature">
              <div class="cell signature__cell">
                <p class="label">Signatura de la mare, el pare o el tutor</p>
                <p class="hand signature__ink" id="signature" aria-live="off"></p>
              </div>
              <div class="cell signature__cell">
                <p class="label">Data</p>
                <p class="hand signature__ink" id="signature-date"></p>
              </div>
            </div>
            <div class="signup__foot">
              <label class="consent">
                <input type="checkbox" name="consent" required />
                <span>Accepto que el club faci servir aquestes dades només per respondre la preinscripció.</span>
              </label>
              <p class="field__error hand hand--red" id="f-consent-err"></p>
              <div class="signup__send">
                <button class="btn btn--ink" type="submit">Signa i envia</button>
                <p class="signup__how">S’obrirà el teu correu amb tot omplert: només cal prémer enviar.</p>
              </div>
              <p class="signup__done hand" id="signup-done" aria-live="polite"></p>
            </div>
          </form>
        </section>
      </div>

      <!-- Running score column -->
      <aside class="score" aria-hidden="true">
        <div class="score__stick">
        <p class="score__title">Tanteig</p>
        <ol class="score__list">
          {
            tanteig.map((n) => (
              <li>
                <span>{n}</span>
                <svg viewBox="0 0 20 20">
                  <path d="M3 17L17 3" />
                </svg>
              </li>
            ))
          }
        </ol>
        </div>
      </aside>
    </div>
  </main>

  <footer class="foot">
    <div class="sheet foot__inner">
      <div class="foot__sign">
        <p class="label">Signatura del club</p>
        <p class="hand foot__hand">{club.nomCurt}</p>
        <p class="foot__motto">{club.lema}</p>
      </div>
      <div>
        <p class="label">Adreça</p>
        <p>{club.adreca.pavello}<br />{club.adreca.carrer}<br />{club.adreca.cp} {club.adreca.poblacio}</p>
      </div>
      <div>
        <p class="label">Correus</p>
        <p>
          <a href={`mailto:${club.correus.general}`}>{club.correus.general}</a><br />
          <a href={`mailto:${club.correus.junta}`}>{club.correus.junta}</a>
        </p>
      </div>
      <div>
        <p class="label">Competició</p>
        <p><a href={club.federacio} rel="noopener">Federació Catalana de Bàsquet</a></p>
      </div>
    </div>
    <div class="foot__bar">
      <div class="sheet">© {club.fundacio}–{new Date().getFullYear()} {club.nom}</div>
    </div>
  </footer>
</Base>

<script is:inline define:vars={{ grupsJson, correu: club.correus.general }}>
  const grups = JSON.parse(grupsJson);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const findGrup = (year) => {
    const adult = grups.find((g) => g.anys[0] === null && g.anys[1] !== null);
    for (const g of grups) {
      const [a, b] = g.anys;
      if (a !== null && year >= a && year <= b) return g;
    }
    if (adult && year <= adult.anys[1]) return adult;
    return null;
  };

  // Birth year → scorer circles the group's row
  const finder = document.getElementById('finder');
  const input = document.getElementById('any');
  const result = document.getElementById('finder-result');
  const formYear = document.getElementById('f-any');
  const formGrup = document.getElementById('f-grup');

  const circle = (num) => {
    document.querySelectorAll('.roster tr.is-circled').forEach((r) => r.classList.remove('is-circled'));
    const row = document.getElementById(`grup-${num}`);
    if (!row) return;
    row.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    setTimeout(() => row.classList.add('is-circled'), reduce ? 0 : 550);
  };

  const writeResult = (html) => {
    result.innerHTML = html;
    result.classList.remove('is-written');
    void result.offsetWidth;
    result.classList.add('is-written');
  };

  finder.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input.value.trim();
    const year = Number(value);
    const now = new Date().getFullYear();
    if (!/^\d{4}$/.test(value) || year < 1930 || year > now) {
      writeResult('<span class="hand--red">Escriu l’any amb quatre xifres, per exemple 2017.</span>');
      return;
    }
    const g = findGrup(year);
    if (!g) {
      writeResult('Encara és aviat per a l’Escoleta. <a href="#preinscripcio">Escriu-nos</a> i us avisem quan sigui l’hora.');
      return;
    }
    writeResult(`Nascuts el ${year}: <a href="#grup-${g.num}">${g.nom}</a>, fila ${g.num} de l’acta.`);
    circle(g.num);
    formYear.value = value;
    formGrup.value = g.nom;
  });

  input.addEventListener('input', () => {
    input.value = input.value.replace(/\D/g, '').slice(0, 4);
  });

  formYear.addEventListener('change', () => {
    const g = findGrup(Number(formYear.value));
    if (g && !formGrup.value) formGrup.value = g.nom;
  });

  // Signature box mirrors the guardian's name in biro
  const tutor = document.getElementById('f-tutor');
  const signature = document.getElementById('signature');
  document.getElementById('signature-date').textContent = new Date().toLocaleDateString('ca-ES');
  tutor.addEventListener('input', () => {
    signature.textContent = tutor.value.trim();
  });

  // Pre-registration: validate, then compose an email
  const form = document.getElementById('signup');
  const done = document.getElementById('signup-done');
  const messages = {
    nom: 'Falta el nom del jugador o jugadora.',
    any: 'Escriu l’any de naixement amb quatre xifres.',
    tutor: 'Falta el nom de la persona de contacte.',
    tel: 'Falta un telèfon per poder trucar-vos.',
    mail: 'Revisa el correu: ha de ser com nom@exemple.cat.',
    consent: 'Cal acceptar-ho per poder respondre’t.',
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let first = null;
    for (const [name, msg] of Object.entries(messages)) {
      const field = form.elements[name];
      const err = document.getElementById(`f-${name}-err`);
      const bad = name === 'any' ? !/^\d{4}$/.test(field.value.trim()) : !field.checkValidity();
      field.setAttribute('aria-invalid', bad ? 'true' : 'false');
      if (err) {
        err.textContent = bad ? msg : '';
        if (bad) field.setAttribute('aria-describedby', err.id);
      }
      if (bad && !first) first = field;
    }
    if (first) {
      first.focus();
      done.textContent = '';
      return;
    }
    const d = Object.fromEntries(new FormData(form));
    const body = [
      `Jugador/a: ${d.nom}`,
      `Any de naixement: ${d.any}`,
      `Grup: ${d.grup || 'No ho sé'}`,
      `Contacte: ${d.tutor}`,
      `Telèfon: ${d.tel}`,
      `Correu: ${d.mail}`,
      d.obs ? `Observacions: ${d.obs}` : '',
    ]
      .filter(Boolean)
      .join('\n');
    const subject = `Preinscripció ${d.grup || ''} - ${d.nom}`.replace(/\s+/g, ' ');
    window.location.href = `mailto:${correu}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    done.textContent = 'Fet! Si no s’ha obert el correu, escriu-nos a ' + correu + '.';
  });

  // Running score: slash numbers as the page is read
  const items = [...document.querySelectorAll('.score__list li')];
  if (items.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? window.scrollY / max : 1;
      const n = Math.round(p * items.length);
      items.forEach((li, i) => li.classList.toggle('is-marked', i < n));
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  if (reduce) document.documentElement.classList.add('reduce');
</script>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 20;
    background: var(--paper);
    color: var(--ink);
    padding: 10px 14px;
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }

  /* Labels printed on the form */
  .label,
  dt,
  .finder__cell label,
  .field label {
    font-size: 12px;
    font-weight: 600;
    font-stretch: 88%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border: 2px solid var(--ink);
    border-radius: 2px;
    font-weight: 700;
    font-stretch: 96%;
    font-size: 16px;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--ink {
    background: var(--ink);
    color: var(--paper);
  }
  .btn--ink:hover {
    background: #0a3836;
  }
  .btn--paper {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .btn--paper:hover {
    background: #fff;
  }

  .link {
    color: var(--pen-blue);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }
  .link:hover {
    text-decoration-thickness: 2.5px;
  }

  /* Top bar */
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--paper);
  }
  .bar__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
  }
  .bar__title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-right: auto;
    font-stretch: 92%;
  }
  .bar__strong {
    font-weight: 750;
    font-size: 18px;
    letter-spacing: 0.01em;
  }
  .bar__season {
    font-size: 14px;
    color: #b9d3cf;
  }
  .bar__nav {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .bar__nav a {
    text-decoration: none;
    padding: 8px 0;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1.5px;
    transition: background-size 0.3s var(--ease-out);
  }
  .bar__nav a:hover {
    background-size: 100% 1.5px;
  }
  .bar .btn {
    min-height: 40px;
    padding: 0 16px;
    font-size: 15px;
  }
  .bar :focus-visible {
    outline-color: var(--paper);
  }

  /* The sheet */
  .acta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 64px;
    border-inline: 1.5px solid var(--rule-strong);
    background: var(--paper);
  }
  .acta__body {
    min-width: 0;
  }

  .cell {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 10px 14px 12px;
  }

  /* Acta header */
  .head {
    display: grid;
    grid-template-columns: 184px 1fr;
    border-bottom: 1.5px solid var(--rule-strong);
  }
  .head__seal {
    display: grid;
    place-items: center;
    padding: 16px;
    border-right: 1.5px solid var(--rule-strong);
  }
  .head__seal img {
    width: 148px;
    height: auto;
  }
  .head__fields {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin: 0;
  }
  .head__fields .cell {
    grid-column: span 2;
  }
