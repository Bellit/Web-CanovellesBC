---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { club } from '../../data/club';

const seccions = [
  { href: '/club/historia/', titol: 'Història', text: 'De l’únic sènior masculí de 1995 a un club amb escola i equips de totes les edats.' },
  { href: '/club/valors/', titol: 'Valors, missió i visió', text: 'Generositat, respecte, pertinença, compromís, humilitat i perseverança.' },
  { href: '/equips/', titol: 'Equips i cos tècnic', text: `Tots els equips de la temporada ${club.temporada}.` },
  { href: '/contacte/', titol: 'Instal·lacions', text: `${club.adreca.pavello}, ${club.adreca.carrer}.` },
];
---

<BaseLayout title="El club" description="Història, valors, missió i visió del Canovelles Bàsquet Club.">
  <PageHeader eyebrow={`Des de ${club.fundacio}`} title="El club" intro="Un club petit amb jugadors molt grans. Coneix d'on venim i què ens mou." />
  <section class="container-club grid gap-6 py-16 sm:grid-cols-2">
    {seccions.map(({ href, titol, text }) => (
      <a href={href} class="group rounded-lg bg-white p-8 shadow-sm ring-1 ring-navy-900/5 transition hover:shadow-lg hover:ring-gold-500">
        <h2 class="text-4xl text-navy-900 group-hover:text-royal-600">{titol}</h2>
        <p class="mt-3 text-ink/75">{text}</p>
      </a>
    ))}
  </section>
</BaseLayout>
