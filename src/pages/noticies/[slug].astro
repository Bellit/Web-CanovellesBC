---
import { url } from '@/lib/url';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dataLlarga, getNoticies } from '../../lib/contingut';

export const getStaticPaths = (async () => {
  const noticies = await getNoticies();
  return noticies.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}) satisfies GetStaticPaths;

const { noticia } = Astro.props;
const { titol, data, resum, portada, etiquetes, equip } = noticia.data;
const { Content } = await render(noticia);
---

<BaseLayout title={titol} description={resum} image={portada} type="article">
  <article>
    <header class="bg-navy-900 text-white">
      <div class="container-club max-w-4xl py-14 lg:py-20">
        <a href={url('/noticies/')} class="font-semibold text-gold-400 hover:underline">← Notícies</a>
        <h1 class="mt-6 text-5xl sm:text-6xl">{titol}</h1>
        <p class="mt-5 text-white/70">
          <time datetime={data.toISOString()}>{dataLlarga(data)}</time>
          {etiquetes.map((e) => <span class="ml-2 rounded bg-white/10 px-2 py-0.5 capitalize">{e}</span>)}
        </p>
      </div>
    </header>
    <div class="container-club max-w-4xl py-12">
      {portada && <Image src={portada} alt="" width={1200} class="-mt-20 mb-10 w-full rounded-lg shadow-xl" />}
      <div class="prose-club"><Content /></div>
      {equip && <a href={url(`/equips/${equip}/`)} class="btn-navy mt-12">Veure l'equip</a>}
    </div>
  </article>
</BaseLayout>
