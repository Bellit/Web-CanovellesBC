---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  equip: CollectionEntry<'equips'>;
}

const { equip } = Astro.props;
const { nom, genere, foto } = equip.data;
const etiquetaGenere = { masculi: 'Masculí', femeni: 'Femení', mixt: 'Mixt' }[genere];
---

<a
  href={`/equips/${equip.id}/`}
  class="group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-lg bg-navy-800 p-5 text-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
>
  {foto ? (
    <Image src={foto} alt="" width={480} class="absolute inset-0 size-full object-cover opacity-60 transition group-hover:scale-105" />
  ) : (
    <span aria-hidden="true" class="absolute -top-3 -left-2 font-display text-[7rem] leading-none font-extrabold whitespace-nowrap text-white/[0.06] uppercase">
      {nom.split(/[ -]/)[0]}
    </span>
  )}
  <span class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/20 to-transparent"></span>
  <span class="relative font-display text-sm font-bold tracking-widest text-gold-400 uppercase">{etiquetaGenere}</span>
  <span class="relative font-display text-3xl leading-none font-bold uppercase">{nom}</span>
  <span class="absolute top-0 left-0 h-1 w-0 bg-gold-500 transition-all group-hover:w-full"></span>
</a>
