---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { dataLlarga } from '../lib/contingut';

interface Props {
  noticia: CollectionEntry<'noticies'>;
}

const { noticia } = Astro.props;
const { titol, data, resum, portada, etiquetes } = noticia.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-navy-900/5 transition hover:shadow-lg">
  <div class="aspect-video overflow-hidden bg-navy-800">
    {portada && <Image src={portada} alt="" width={640} class="size-full object-cover transition group-hover:scale-105" />}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm text-ink/60">
      <time datetime={data.toISOString()}>{dataLlarga(data)}</time>
      {etiquetes[0] && <span class="ml-2 rounded bg-gold-500/20 px-2 py-0.5 font-semibold text-navy-900 capitalize">{etiquetes[0]}</span>}
    </p>
    <h3 class="mt-3 text-2xl text-navy-900">
      <a href={`/noticies/${noticia.id}/`} class="after:absolute after:inset-0 group-hover:text-royal-600">{titol}</a>
    </h3>
    <p class="mt-3 line-clamp-3 text-ink/75">{resum}</p>
  </div>
</article>
