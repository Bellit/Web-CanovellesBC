---
import { url } from '@/lib/url';
import { club, navegacio } from '../data/club';

const xarxes = Object.entries(club.xarxes).filter(([, enllac]) => enllac);
const any = new Date().getFullYear();
---

<footer class="bg-navy-950 text-white/80">
  <div class="container-club grid gap-10 py-14 md:grid-cols-3">
    <div>
      <a href={url('/')} class="flex items-center gap-3 text-white">
        <img src={url('/escut.svg')} alt="" width="48" height="54" class="h-14 w-auto" />
        <span class="font-display text-3xl leading-none font-extrabold uppercase">Canovelles <span class="text-gold-500">BC</span></span>
      </a>
      <p class="mt-4 max-w-xs">Bàsquet a Canovelles des de {club.fundacio}.</p>
      <p class="mt-2 font-display text-xl font-bold text-gold-500">{club.lema}</p>
    </div>

    <nav aria-label="Peu de pàgina">
      <h2 class="text-xl text-white">El club</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2">
        {navegacio.map(({ href, label }) => <li><a href={url(href)} class="hover:text-gold-400">{label}</a></li>)}
        <li><a href={url('/inscripcions/')} class="hover:text-gold-400">Inscripcions</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-xl text-white">On som</h2>
      <address class="mt-4 not-italic">
        {club.adreca.pavello}<br />
        {club.adreca.carrer}, {club.adreca.cp} {club.adreca.poblacio}<br />
        <a href={`mailto:${club.correus.general}`} class="mt-2 inline-block font-semibold text-gold-400 hover:underline">{club.correus.general}</a>
      </address>
      {xarxes.length > 0 && (
        <ul class="mt-4 flex gap-4">
          {xarxes.map(([nom, enllac]) => <li><a href={enllac} class="capitalize hover:text-gold-400" rel="noopener">{nom}</a></li>)}
        </ul>
      )}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-club flex flex-col gap-2 py-5 text-sm sm:flex-row sm:justify-between">
      <p>© {any} {club.nom}</p>
      <ul class="flex gap-4">
        <li><a href={url('/avis-legal/')} class="hover:text-gold-400">Avís legal</a></li>
        <li><a href={url('/privacitat/')} class="hover:text-gold-400">Privacitat</a></li>
        <li><a href={url('/cookies/')} class="hover:text-gold-400">Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>
