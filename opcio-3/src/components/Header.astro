---
import { url } from '../lib/url';

interface Props {
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;

const links = [
  { href: url('/#grups'), label: 'Troba el grup' },
  { href: url('/#etapes'), label: 'Etapes' },
  { href: url('/#club'), label: 'El club' },
  { href: url('/#on-som'), label: 'On som' },
];
---

<header class="header">
  <div class="wrap header__in">
    <a class="brand" href={url('/')}>
      <img src={url('/escut.svg')} alt="" width="44" height="40" />
      <span>Canovelles <b>BC</b></span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    {!hideCta && <a class="btn header__cta" href={url('/preinscripcio/')}>Preinscripció</a>}
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(238 240 243 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 3px solid var(--court);
  }
  .header__in {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: -0.01em;
  }
  .brand img {
    width: 44px;
  }
  .brand b {
    color: var(--court);
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: clamp(14px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    position: relative;
    padding-block: 6px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    border-radius: 3px;
    background: var(--zone);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  .header__cta {
    min-height: 44px;
    padding-inline: 18px;
    font-size: 16px;
  }
  /* En mòbil els enllaços baixen a una segona fila, sobre una línia de pista. */
  @media (max-width: 860px) {
    .header__in {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .header__cta {
      margin-left: auto;
    }
    nav {
      order: 5;
      width: 100%;
      margin: 0;
      border-top: 2px solid var(--floor-deep);
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      gap: 20px;
    }
    nav a {
      display: inline-block;
      padding-block: 10px;
      font-size: 15px;
      white-space: nowrap;
    }
  }
</style>
