---
import { club } from '../data/club';
import { url } from '../lib/url';
---

<footer class="footer">
  <svg class="footer__arc" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 118 H460 A140 140 0 0 1 740 118 H1200" />
  </svg>
  <div class="wrap footer__in">
    <div class="footer__brand">
      <img src={url('/escut.svg')} alt="Escut del Canovelles Bàsquet Club" width="88" height="80" />
      <p><b>{club.nom}</b><br />{club.lema}</p>
    </div>
    <div>
      <h2>On som</h2>
      <p>{club.adreca.pavello}<br />{club.adreca.carrer}<br />{club.adreca.cp} {club.adreca.poblacio}</p>
    </div>
    <div>
      <h2>Escriu-nos</h2>
      <p><a href={`mailto:${club.correus.general}`}>{club.correus.general}</a></p>
      <p><a href={`mailto:${club.correus.junta}`}>{club.correus.junta}</a></p>
    </div>
    <div>
      <h2>Temporada {club.temporada}</h2>
      <p>Competim a la <a href={club.federacio} rel="noopener">Federació Catalana de Bàsquet</a>.</p>
      <p><a href={url('/preinscripcio/')}>Preinscripció</a></p>
    </div>
  </div>
  <p class="wrap footer__legal">© {club.nom} · des de {club.fundacio}</p>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--ink);
    color: #d9deea;
    padding: clamp(56px, 7vw, 96px) 0 28px;
    overflow: hidden;
  }
  .footer__arc {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: clamp(40px, 6vw, 80px);
    fill: none;
    stroke: var(--line);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    opacity: 0.7;
  }
  .footer__in {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 32px;
  }
  .footer__brand {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .footer__brand img {
    width: 88px;
  }
  .footer__brand b {
    color: var(--white);
  }
  h2 {
    margin-bottom: 10px;
    color: var(--line);
    font-size: 17px;
    font-stretch: 100%;
    font-weight: 700;
    letter-spacing: 0;
  }
  .footer p + p {
    margin-top: 6px;
  }
  .footer a:hover {
    color: var(--white);
  }
  .footer__legal {
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 14px;
    color: #a9b2c8;
  }
  @media (max-width: 860px) {
    .footer__in {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__in {
      grid-template-columns: 1fr;
    }
  }
</style>
