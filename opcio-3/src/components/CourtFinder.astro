---
import { grups, nascuts, generesNom } from '../data/club';
import { url } from '../lib/url';

// Posició de cada grup sobre la mitja pista (en % de l'amplada i l'alçada del dibuix):
// del cèrcol cap al mig camp, com el camí que fa un jugador dins del club.
const pos: Record<string, [number, number]> = {
  Escoleta: [50, 21],
  Escobol: [33, 31],
  'Pre-Mini': [67, 35],
  Mini: [50, 48],
  Infantil: [21, 50],
  Cadet: [79, 54],
  Júnior: [50, 64],
  'Sots-21 i Sots-25': [24, 72],
  Sèniors: [76, 81],
  Veteranes: [50, 90],
};
// Recorregut de cada grup: del cèrcol, passant per tots els grups anteriors, fins al seu lloc.
const rutaFins = (i: number) =>
  'M250 52 ' + grups.slice(0, i + 1).map((g) => `L${pos[g.nom][0] * 5} ${pos[g.nom][1] * 4.7}`).join(' ');
---

<section class="finder" id="grups" aria-labelledby="grups-titol">
  <div class="wrap finder__in">
    <div class="finder__head" data-reveal>
      <h2 id="grups-titol">Troba el seu grup a la pista</h2>
      <p>Escriu l’any de naixement i la pilota anirà fins al seu grup. Del cèrcol al mig camp: així creix un jugador al Canovelles.</p>
      <form class="finder__form" id="finder-form" autocomplete="off">
        <label for="finder-any">Any de naixement</label>
        <div class="finder__row">
          <input id="finder-any" inputmode="numeric" maxlength="4" placeholder="2017" aria-describedby="finder-msg" />
          <button class="btn btn--line" type="submit">Busca</button>
        </div>
        <p class="finder__msg" id="finder-msg" aria-live="polite"></p>
      </form>
    </div>

    <div class="court" data-paint-group>
      <svg viewBox="0 0 500 470" aria-hidden="true">
        <rect class="court__paint" x="168" y="0" width="164" height="193" />
        <g class="court__lines">
          <path data-paint pathLength="1" d="M2 468 V2 H498 V468 Z" />
          <path data-paint pathLength="1" style="--i:1" d="M168 0 V193 H332 V0" />
          <path data-paint pathLength="1" style="--i:2" d="M190 193 A60 60 0 0 0 310 193 A60 60 0 0 0 190 193" />
          <path data-paint pathLength="1" style="--i:3" d="M30 0 V97 A225 225 0 0 0 470 97 V0" />
          <path data-paint pathLength="1" style="--i:4" d="M208 52 A42 42 0 0 0 292 52" />
          <path data-paint pathLength="1" style="--i:5" d="M190 468 A60 60 0 0 1 310 468" />
        </g>
        <path class="court__route" id="route" d="M250 52" />
        <line class="court__board" x1="220" y1="40" x2="280" y2="40" />
        <circle class="court__rim" cx="250" cy="52" r="11" />
      </svg>

      <svg class="ball" id="ball" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" />
        <path d="M2 20 H38 M20 2 V38 M7 7 C15 14 15 26 7 33 M33 7 C25 14 25 26 33 33" />
      </svg>

      <ul class="spots">
        {
          grups.map((g, i) => {
            const [x, y] = pos[g.nom];
            return (
              <li style={`--x:${x}%;--y:${y}%`}>
                <button type="button" class="spot" data-grup={g.nom} data-route={rutaFins(i)} aria-pressed="false">
                  <span class="spot__dot" />
                  <span class="spot__name">{g.nom}</span>
                </button>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="detail" id="detail" aria-live="polite">
      {
        grups.map((g, i) => (
          <article class="detail__card" data-card={g.nom} hidden>
            <h3>{g.nom}</h3>
            <dl>
              <div>
                <dt>Nascuts</dt>
                <dd>{nascuts(g.anys)}</dd>
              </div>
              <div>
                <dt>Equips</dt>
                <dd>{g.equips.map((e) => generesNom[e]).join(' i ')}</dd>
              </div>
            </dl>
            <p>{g.nota}</p>
            <a class="btn detail__cta" href={url(`/preinscripcio/?grup=${encodeURIComponent(g.nom)}`)} data-cta>
              Preinscripció a {g.nom}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </a>
          </article>
        ))
      }
      <p class="detail__note">Anys orientatius segons les categories de la Federació, pendents de confirmar pel club.</p>
    </div>
  </div>
</section>

<script>
  import { grupPerAny } from '../data/club';

  const court = document.querySelector<HTMLElement>('.court')!;
  const ball = document.getElementById('ball')!;
  const route = document.getElementById('route') as unknown as SVGPathElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let turn = 0;
  let last: [number, number] = [50, 11];
  const form = document.getElementById('finder-form') as HTMLFormElement;
  const input = document.getElementById('finder-any') as HTMLInputElement;
  const msg = document.getElementById('finder-msg')!;
  const spots = [...document.querySelectorAll<HTMLButtonElement>('.spot')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  let year = '';

  function select(nom: string) {
    const spot = spots.find((s) => s.dataset.grup === nom)!;
    const li = spot.parentElement!;
    spots.forEach((s) => s.setAttribute('aria-pressed', String(s === spot)));
    cards.forEach((c) => (c.hidden = c.dataset.card !== nom));
    const x = li.style.getPropertyValue('--x');
    const y = li.style.getPropertyValue('--y');
    // La pilota roda: gira segons la distància que recorre.
    const to: [number, number] = [parseFloat(x), parseFloat(y)];
    turn += Math.hypot(to[0] - last[0], to[1] - last[1]) * 9;
    last = to;
    ball.style.left = x;
    ball.style.top = y;
    ball.style.rotate = `${turn}deg`;
    court.classList.add('has-ball');

    // El camí es pinta del cèrcol fins al grup triat.
    route.setAttribute('d', spot.dataset.route!);
    const len = route.getTotalLength();
    route.style.transition = 'none';
    route.style.strokeDasharray = `${len}`;
    route.style.strokeDashoffset = reduce ? '0' : `${len}`;
    route.getBoundingClientRect();
    if (!reduce) {
      route.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
      route.style.strokeDashoffset = '0';
    }
    const cta = cards.find((c) => !c.hidden)?.querySelector<HTMLAnchorElement>('[data-cta]');
    if (cta) {
      const u = new URL(cta.href);
      if (year) u.searchParams.set('any', year);
      else u.searchParams.delete('any');
      cta.href = u.toString();
    }
  }

  spots.forEach((s) =>
    s.addEventListener('click', () => {
      year = '';
      msg.textContent = '';
      select(s.dataset.grup!);
    }),
  );

  input.addEventListener('input', () => {
    input.value = input.value.replace(/\D/g, '').slice(0, 4);
  });

  select(spots[0].dataset.grup!);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = input.value;
    if (!/^\d{4}$/.test(v)) {
      msg.textContent = 'Escriu l’any amb quatre xifres, per exemple 2017.';
      return;
    }
    const g = grupPerAny(Number(v));
    if (!g) {
      msg.textContent = 'Encara és molt petit: l’Escoleta comença amb els nascuts el 2022.';
      return;
    }
    year = v;
    msg.textContent = `Nascut el ${v}: li toca ${g.nom}.`;
    select(g.nom);
  });
</script>

<style>
  .finder {
    position: relative;
    background: var(--court);
    color: var(--white);
    padding-block: clamp(64px, 8vw, 120px);
    overflow: hidden;
  }
  .finder__in {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    grid-template-areas:
      'head court'
      'detail court';
    grid-template-rows: auto 1fr;
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 72px);
  }
  .finder__head {
    grid-area: head;
  }
  .finder h2 {
    font-size: clamp(38px, 4.6vw, 64px);
  }
  .finder__head > p {
    margin-top: 16px;
    max-width: 40ch;
    color: #dbe4fb;
  }
  .finder__form {
    margin-top: 28px;
  }
  .finder__form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }
  .finder__row {
    display: flex;
    gap: 10px;
  }
  .finder__row input {
    width: 9ch;
    min-height: 52px;
    padding: 0 14px;
    border: 3px solid var(--white);
    border-radius: var(--radius);
    background: var(--court-deep);
    color: var(--white);
    font: 800 24px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .finder__row input::placeholder {
    color: rgb(255 255 255 / 0.55);
  }
  .finder__row input:focus-visible {
    outline-color: var(--line);
    border-color: var(--line);
  }
  .finder__msg {
    min-height: 1.6em;
    margin-top: 10px;
    font-weight: 600;
    color: var(--line);
  }

  .court {
    grid-area: court;
    position: relative;
    align-self: start;
    aspect-ratio: 500 / 470;
  }
  .court > svg:first-child {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .court__paint {
    fill: var(--zone);
  }
  .court__lines path {
    fill: none;
    stroke: var(--white);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .court__route {
    fill: none;
    stroke: var(--line);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .court__board {
    stroke: var(--white);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .court__rim {
    fill: none;
    stroke: var(--line);
    stroke-width: 4;
  }

  .spots {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spots li {
    position: absolute;
    left: var(--x);
    top: var(--y);
  }
  .spot {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    translate: -11px -50%;
    padding: 4px 10px 4px 4px;
    border: 0;
    border-radius: 999px;
    background: var(--court);
    color: var(--white);
    font: 700 clamp(13px, 1.1vw, 16px) / 1.1 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }
  /* Àrea de toc de 44px sense fer més gran la pastilla. */
  .spot::before {
    content: '';
    position: absolute;
    inset: -10px -4px;
  }
  .spot__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--court);
    transition: background-color 0.35s var(--ease), scale 0.35s var(--ease);
  }
  .spot__name {
    text-shadow: 0 1px 2px rgb(15 27 61 / 0.6);
  }
  .spot:hover {
    background: var(--court-deep);
  }
  .spot:hover .spot__dot {
    scale: 1.2;
  }
  .spot[aria-pressed='true'] {
    background: var(--line);
    color: var(--ink);
  }
  .spot[aria-pressed='true'] .spot__name {
    text-shadow: none;
  }
  .spot[aria-pressed='true'] .spot__dot {
    background: var(--ink);
    border-color: var(--ink);
  }
  /* Els grups de la dreta obren l'etiqueta cap a l'esquerra perquè no surti de la pista. */
  .spots li:nth-child(6) .spot,
  .spots li:nth-child(9) .spot {
    flex-direction: row-reverse;
    translate: calc(-100% + 11px) -50%;
    padding: 4px 4px 4px 10px;
  }

  .ball {
    position: absolute;
    left: 50%;
    top: 11%;
    z-index: 2;
    width: clamp(26px, 3vw, 36px);
    translate: -50% -130%;
    opacity: 0;
    pointer-events: none;
    transition:
      left 0.9s var(--ease),
      top 0.9s var(--ease),
      rotate 0.9s var(--ease),
      opacity 0.3s;
  }
  .has-ball .ball {
    opacity: 1;
  }
  .ball circle {
    fill: #f07c28;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .ball path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .detail {
    grid-area: detail;
    align-self: end;
  }
  .detail__card {
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 18px 40px -18px rgb(5 14 40 / 0.6);
    animation: card-in 0.6s var(--ease);
  }
  .detail__card h3 {
    font-size: clamp(30px, 3vw, 42px);
    color: var(--court);
  }
  .detail__card dl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 16px 0 12px;
  }
  .detail__card dt {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .detail__card dd {
    margin: 0;
    font: 800 22px/1.2 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .detail__card > p {
    color: var(--ink-soft);
  }
  .detail__cta {
    margin-top: 20px;
  }
  .detail__note {
    margin-top: 14px;
    font-size: 14px;
    color: #c3d0f4;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 900px) {
    .finder__in {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'court' 'detail';
    }
    .spot {
      padding-right: 6px;
      gap: 6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ball,
    .detail__card {
      transition: none;
      animation: none;
    }
  }
</style>
