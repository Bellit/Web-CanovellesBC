---
import Base from '../layouts/Base.astro';
import { club, grups } from '../data/club';
---

<Base title="Preinscripció" description={`Preinscripció al ${club.nom} per a la temporada ${club.temporada}.`} hideCta>
  <main id="principal" class="wrap signup">
    <header class="signup__head">
      <span class="window signup__tag"><span class="dots">TM</span></span>
      <h1 class="plate">Temps mort: preinscripció</h1>
      <p>Temporada {club.temporada}. Omple-ho en un minut i et responem amb l’horari i la quota del seu grup. No cal pagar res ara.</p>
    </header>

    <form class="form" id="signup" novalidate>
      <fieldset>
        <legend class="plate">El jugador o la jugadora</legend>
        <div class="field field--wide">
          <label for="f-nom">Nom i cognoms</label>
          <input id="f-nom" name="nom" required autocomplete="off" autocapitalize="words" />
          <p class="field__error" id="f-nom-err"></p>
        </div>
        <div class="field">
          <label for="f-any">Any de naixement</label>
          <input id="f-any" name="any" required inputmode="numeric" maxlength="4" autocomplete="off" placeholder="2017" />
          <p class="field__error" id="f-any-err"></p>
        </div>
        <div class="field">
          <label for="f-grup">Grup</label>
          <select id="f-grup" name="grup">
            <option value="">Encara no ho sé</option>
            {grups.map((g) => <option value={g.nom}>{g.nom}</option>)}
          </select>
        </div>
      </fieldset>
      <fieldset>
        <legend class="plate">La persona de contacte</legend>
        <div class="field field--wide">
          <label for="f-tutor">Nom de la mare, el pare o el tutor</label>
          <input id="f-tutor" name="tutor" required autocomplete="name" />
          <p class="field__error" id="f-tutor-err"></p>
        </div>
        <div class="field">
          <label for="f-tel">Telèfon</label>
          <input id="f-tel" name="tel" type="tel" required autocomplete="tel" />
          <p class="field__error" id="f-tel-err"></p>
        </div>
        <div class="field">
          <label for="f-mail">Correu electrònic</label>
          <input id="f-mail" name="mail" type="email" required autocomplete="email" />
          <p class="field__error" id="f-mail-err"></p>
        </div>
        <div class="field field--wide">
          <label for="f-obs">Alguna cosa que hàgim de saber? <span>(opcional)</span></label>
          <textarea id="f-obs" name="obs" rows="3"></textarea>
        </div>
      </fieldset>
      <div class="form__foot">
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>Accepto que el club faci servir aquestes dades només per respondre la preinscripció.</span>
        </label>
        <p class="field__error" id="f-consent-err"></p>
        <button class="push" type="submit">
          <span class="push__cap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span>
          <span class="push__label"><b>Envia</b><span>S’obrirà el teu correu amb tot omplert</span></span>
        </button>
        <p class="form__done" id="signup-done" aria-live="polite"></p>
      </div>
    </form>

    <aside class="mini-board" aria-label="Vista prèvia al marcador">
      <div class="mini-board__in">
        <p class="plate mini-board__plate">Nou fitxatge</p>
        <div class="window mini-board__win">
          <p class="dots mini-board__name" id="mb-nom">EL SEU NOM</p>
        </div>
        <div class="mini-board__row">
          <div>
            <p class="plate mini-board__label">Nascut</p>
            <div class="window mini-board__small"><span class="dots" id="mb-any">----</span></div>
          </div>
          <div>
            <p class="plate mini-board__label">Grup</p>
            <div class="window mini-board__small"><span class="dots mini-board__grup" id="mb-grup">?</span></div>
          </div>
        </div>
      </div>
    </aside>
  </main>
</Base>

<script>
  import { club, grupPerAny } from '../data/club';

  const form = document.getElementById('signup') as HTMLFormElement;
  const nom = form.elements.namedItem('nom') as HTMLInputElement;
  const year = form.elements.namedItem('any') as HTMLInputElement;
  const grup = form.elements.namedItem('grup') as HTMLSelectElement;
  const done = document.getElementById('signup-done')!;
  const mbNom = document.getElementById('mb-nom')!;
  const mbAny = document.getElementById('mb-any')!;
  const mbGrup = document.getElementById('mb-grup')!;

  // Recull el que s'ha triat a la consola de la portada.
  const params = new URLSearchParams(location.search);
  for (const key of ['any', 'grup'] as const) {
    const v = params.get(key);
    const el = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
    if (v && el) el.value = key === 'any' ? v.replace(/\D/g, '').slice(0, 4) : v;
  }

  const paint = () => {
    mbNom.textContent = nom.value.trim().toUpperCase() || 'EL SEU NOM';
    mbNom.classList.toggle('is-set', !!nom.value.trim());
    mbAny.textContent = year.value.padEnd(4, '-');
    mbGrup.textContent = grup.value ? grup.value.toUpperCase() : '?';
  };

  let autoGrup = !grup.value;
  grup.addEventListener('change', () => {
    autoGrup = false;
    paint();
  });
  nom.addEventListener('input', paint);
  year.addEventListener('input', () => {
    year.value = year.value.replace(/\D/g, '').slice(0, 4);
    if (autoGrup) {
      const g = year.value.length === 4 ? grupPerAny(Number(year.value)) : null;
      grup.value = g ? g.nom : '';
    }
    paint();
  });
  paint();

  const messages: Record<string, string> = {
    nom: 'Falta el nom del jugador o la jugadora.',
    any: 'Escriu l’any de naixement amb quatre xifres, per exemple 2017.',
    tutor: 'Falta el nom de la persona de contacte.',
    tel: 'Falta un telèfon per poder trucar-vos.',
    mail: 'Revisa el correu: ha de ser com nom@exemple.cat.',
    consent: 'Cal acceptar-ho per poder respondre’t.',
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let first: HTMLInputElement | null = null;
    for (const [name, msg] of Object.entries(messages)) {
      const field = form.elements.namedItem(name) as HTMLInputElement;
      const err = document.getElementById(`f-${name}-err`)!;
      const bad = name === 'any' ? !/^\d{4}$/.test(field.value.trim()) : !field.checkValidity();
      field.setAttribute('aria-invalid', String(bad));
      err.textContent = bad ? msg : '';
      if (bad) field.setAttribute('aria-describedby', err.id);
      else field.removeAttribute('aria-describedby');
      if (bad && !first) first = field;
    }
    if (first) {
      first.focus();
      done.textContent = '';
      return;
    }
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const body = [
      `Jugador/a: ${d.nom}`,
      `Any de naixement: ${d.any}`,
      `Grup: ${d.grup || 'No ho sé'}`,
      `Contacte: ${d.tutor}`,
      `Telèfon: ${d.tel}`,
      `Correu: ${d.mail}`,
      d.obs ? `Observacions: ${d.obs}` : '',
    ]
      .filter(Boolean)
      .join('\n');
    const subject = `Preinscripció ${d.grup || ''} - ${d.nom}`.replace(/\s+/g, ' ');
    const correu = club.correus.general;
    window.location.href = `mailto:${correu}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    done.textContent = `Fet! Si no s’ha obert el correu, escriu-nos a ${correu}.`;
  });
</script>

<style>
  .signup {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'head board'
      'form board';
    grid-template-rows: auto 1fr;
    gap: 0 clamp(32px, 5vw, 80px);
    padding-block: clamp(36px, 5vw, 72px) 0;
  }
  .signup__head {
    grid-area: head;
    display: grid;
    gap: 16px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .signup__tag {
    justify-self: start;
    padding: 8px 12px;
  }
  .signup__tag .dots {
    font-size: 36px;
    color: var(--red);
  }
  .signup h1 {
    font-size: clamp(44px, 6vw, 88px);
    font-weight: 850;
    line-height: 0.88;
  }
  .signup__head p {
    max-width: 50ch;
    color: var(--vinyl-soft);
  }

  .form {
    grid-area: form;
    display: grid;
    gap: clamp(36px, 4vw, 48px);
  }
  fieldset {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    float: left;
    grid-column: 1 / -1;
    width: 100%;
    margin-bottom: 4px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--bezel-hi);
    font-size: clamp(26px, 2.4vw, 34px);
    color: var(--amber);
  }
  .field {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field label {
    font-weight: 700;
  }
  .field label span {
    font-weight: 500;
    color: var(--vinyl-soft);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 2px solid #000;
    border-radius: 3px;
    background: var(--window);
    color: var(--vinyl);
    font: 500 18px/1.3 var(--font-body);
    box-shadow: inset 0 2px 5px rgb(0 0 0 / 0.8);
    transition: border-color 0.15s linear;
  }
  input::placeholder {
    color: #938e82;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--bezel-hi);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--amber);
  }
  input[aria-invalid='true'] {
    border-color: var(--red);
  }
  textarea {
    resize: vertical;
  }
  .field__error {
    font-size: 15px;
    font-weight: 700;
    color: #ff7a63;
  }
  .field__error:empty {
    display: none;
  }
  .form__foot {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    max-width: 60ch;
    color: var(--vinyl-soft);
  }
  .consent input {
    width: 22px;
    min-height: 22px;
    height: 22px;
    margin-top: 2px;
    flex: none;
    box-shadow: none;
  }
  .form__done {
    font-weight: 700;
    color: var(--amber);
  }

  .mini-board {
    grid-area: board;
  }
  .mini-board__in {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 14px;
    padding: 24px;
    background: var(--bezel);
    border: 3px solid #000;
    border-radius: 6px;
    box-shadow: inset 0 2px 0 var(--bezel-hi);
  }
  .mini-board__plate {
    justify-self: start;
    padding: 6px 12px 5px;
    background: var(--home);
    font-size: 22px;
  }
  .mini-board__win {
    padding: 16px;
    min-height: 92px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .mini-board__name {
    font-size: clamp(26px, 2.6vw, 38px);
    color: #5a4a2a;
    overflow-wrap: anywhere;
  }
  .mini-board__name.is-set {
    color: var(--amber);
  }
  .mini-board__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
  }
  .mini-board__label {
    margin-bottom: 6px;
    font-size: 15px;
    color: var(--vinyl-soft);
  }
  .mini-board__small {
    padding: 8px 12px;
    overflow: hidden;
  }
  .mini-board__small .dots {
    font-size: 30px;
    white-space: nowrap;
  }
  .mini-board__grup {
    color: var(--red);
  }

  @media (max-width: 900px) {
    .signup {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'board' 'form';
    }
    .mini-board {
      margin-bottom: 40px;
    }
    .mini-board__in {
      position: static;
    }
  }
  @media (max-width: 560px) {
    fieldset {
      grid-template-columns: 1fr;
    }
  }
</style>
