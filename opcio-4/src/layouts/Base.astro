---
import '../styles/global.css';
import { club } from '../data/club';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  hideCta?: boolean;
}

const { title, description = club.descripcio, hideCta = false } = Astro.props;
const fullTitle = title ? `${title} | ${club.nomCurt}` : `${club.nom} | Juga a casa`;
const noindex = import.meta.env.PUBLIC_PREVIEW === 'true';

const links = [
  { href: url('/#club'), label: 'El club', p: 'P1' },
  { href: url('/#escola'), label: 'Escola', p: 'P2' },
  { href: url('/#grups'), label: 'Grups', p: 'P3' },
  { href: url('/#on-som'), label: 'On som', p: 'P4' },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14161a" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#principal">Salta al contingut</a>
    <header class="rail">
      <div class="wrap rail__in">
        <a class="rail__home" href={url('/')}>
          <img src={url('/escut.svg')} alt="" width="40" height="36" />
          <span class="plate">Canovelles <b>BC</b></span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a class="plate" href={l.href}>
                    <span class="nav__p" aria-hidden="true">{l.p}</span>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="rail__clock" aria-hidden="true">
          <span class="plate">Període</span>
          <span class="dots rail__period" id="rail-period">1</span>
          <span class="dots rail__time" id="rail-time">00:00</span>
        </div>
        {
          !hideCta && (
            <a class="rail__cta plate" href={url('/preinscripcio/')}>
              <span class="rail__led" />
              Temps mort
            </a>
          )
        }
      </div>
    </header>

    <slot />

    <footer class="foot">
      <div class="wrap foot__in">
        <div class="foot__brand">
          <img src={url('/escut.svg')} alt="Escut del Canovelles Bàsquet Club" width="76" height="69" />
          <p>
            <span class="plate">{club.nom}</span><br />
            {club.lema}
          </p>
        </div>
        <p>
          <span class="plate">Pavelló</span><br />
          {club.adreca.pavello}<br />
          {club.adreca.carrer}, {club.adreca.cp} {club.adreca.poblacio}
        </p>
        <p>
          <span class="plate">Taula</span><br />
          <a href={`mailto:${club.correus.general}`}>{club.correus.general}</a><br />
          <a href={`mailto:${club.correus.junta}`}>{club.correus.junta}</a>
        </p>
        <p>
          <span class="plate">Temporada {club.temporada}</span><br />
          Competim a la <a href={club.federacio} rel="noopener">Federació Catalana de Bàsquet</a>.
        </p>
      </div>
      <p class="wrap foot__legal">© {club.nom} · des de {club.fundacio}</p>
    </footer>

    <script>
      // El rellotge de partit: el scroll fa avançar els 40 minuts i el període canvia amb cada secció.
      const time = document.getElementById('rail-time')!;
      const period = document.getElementById('rail-period')!;
      const sections = [...document.querySelectorAll<HTMLElement>('[data-period]')];
      let ticking = false;
      const update = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - innerHeight;
        const p = max > 0 ? Math.min(1, scrollY / max) : 0;
        const secs = Math.round(p * 40 * 60);
        time.textContent = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
        let current = sections[0]?.dataset.period ?? '1';
        for (const s of sections) if (s.getBoundingClientRect().top < innerHeight * 0.45) current = s.dataset.period!;
        period.textContent = current;
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) requestAnimationFrame(update);
          ticking = true;
        },
        { passive: true },
      );
      update();
    </script>

    <style>
      .rail {
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--bezel);
        border-bottom: 3px solid #000;
        box-shadow: 0 1px 0 var(--bezel-hi) inset;
      }
      .rail__in {
        display: flex;
        align-items: center;
        gap: clamp(14px, 2.4vw, 32px);
        min-height: 64px;
      }
      .rail__home {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-size: 22px;
      }
      .rail__home img {
        width: 40px;
      }
      .rail__home b {
        color: var(--amber);
      }
      nav ul {
        display: flex;
        gap: clamp(12px, 2vw, 26px);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      /* Etiquetes de vinil: cada enllaç porta el seu període. */
      nav a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 36px;
        padding: 0 10px 0 4px;
        border: 2px solid #000;
        border-radius: 3px;
        background: var(--vinyl);
        color: var(--window);
        font-size: 18px;
        text-decoration: none;
        transition: background-color 0.15s linear;
      }
      .nav__p {
        padding: 2px 5px;
        border-radius: 2px;
        background: var(--window);
        color: var(--red);
        font-family: var(--font-dot);
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 0;
      }
      nav a:hover {
        background: var(--amber);
      }
      .rail__clock {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        padding: 6px 12px;
        background: var(--window);
        border: 2px solid #000;
        border-radius: 3px;
      }
      .rail__clock .plate {
        font-size: 14px;
        color: var(--vinyl-soft);
      }
      .rail__period {
        font-size: 24px;
        color: var(--red);
      }
      .rail__time {
        min-width: 5ch;
        font-size: 24px;
      }
      .rail__cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 3px;
        background: var(--red);
        color: var(--vinyl);
        font-size: 20px;
        text-decoration: none;
        box-shadow:
          inset 0 -3px 0 rgb(0 0 0 / 0.22),
          0 4px 10px rgb(0 0 0 / 0.5);
        transition: transform 0.08s linear, box-shadow 0.08s linear;
      }
      .rail__cta:active {
        transform: translateY(2px);
        box-shadow:
          inset 0 -1px 0 rgb(0 0 0 / 0.22),
          0 1px 3px rgb(0 0 0 / 0.5);
      }
      .rail__led {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--amber);
        animation: blink 1.2s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          background: #6b3b0a;
        }
      }

      .foot {
        margin-top: clamp(48px, 6vw, 96px);
        padding: clamp(40px, 5vw, 64px) 0 28px;
        background: var(--bezel);
        border-top: 3px solid #000;
        color: var(--vinyl-soft);
        font-size: 16px;
      }
      .foot__in {
        display: grid;
        grid-template-columns: 1.2fr repeat(3, 1fr);
        gap: 32px;
      }
      .foot .plate {
        font-size: 19px;
        color: var(--vinyl);
      }
      .foot__brand {
        display: grid;
        gap: 14px;
        align-content: start;
      }
      .foot__brand img {
        width: 76px;
      }
      .foot a:hover {
        color: var(--amber);
      }
      .foot__legal {
        margin-top: 40px;
        padding-top: 16px;
        border-top: 1px solid var(--bezel-hi);
        font-size: 14px;
      }

      nav a,
      .rail__cta {
        white-space: nowrap;
      }
      @media (max-width: 1180px) {
        .rail__home span {
          display: none;
        }
      }

      /* En pantalles petites les etiquetes baixen a una segona fila del carril. */
      @media (max-width: 980px) {
        .rail__in {
          flex-wrap: wrap;
          row-gap: 0;
        }
        nav {
          order: 5;
          width: 100%;
          margin: 0 calc(-1 * var(--gutter));
          padding: 8px var(--gutter);
          border-top: 2px solid #000;
          overflow-x: auto;
          scrollbar-width: none;
        }
        nav ul {
          gap: 6px;
        }
        nav a {
          min-height: 34px;
          padding: 0 7px 0 3px;
          gap: 5px;
          font-size: 15px;
          white-space: nowrap;
        }
        .nav__p {
          font-size: 13px;
          padding: 2px 3px;
        }
      }
      @media (max-width: 560px) {
        .rail__home span {
          display: none;
        }
        .rail__clock .plate {
          display: none;
        }
        .rail__cta {
          font-size: 18px;
          padding: 0 12px;
        }
        .foot__in {
          grid-template-columns: 1fr;
        }
      }
      @media (min-width: 561px) and (max-width: 860px) {
        .foot__in {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .rail__led {
          animation: none;
        }
      }
    </style>
  </body>
</html>
