---
import { url } from '@/lib/url';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getActivitats } from '../../lib/contingut';

const activitats = await getActivitats();
---

<BaseLayout title="Activitats" description="Torneig PreMini, Torneig 3D3 i altres activitats del Canovelles BC.">
  <PageHeader eyebrow="Més que partits" title="Activitats" intro="Tornejos i trobades que organitza el club per fer pinya amb els clubs veïns i amb les famílies." />
  <section class="container-club grid gap-10 py-16">
    {activitats.map(({ id, data }) => (
      <a href={url(`/activitats/${id}/`)} class="group grid overflow-hidden rounded-lg bg-white shadow-sm transition hover:shadow-lg md:grid-cols-5">
        <div class="aspect-video bg-navy-800 md:col-span-2 md:aspect-auto">
          {data.portada && <Image src={data.portada} alt="" width={640} class="size-full object-cover" />}
        </div>
        <div class="p-8 md:col-span-3">
          <h2 class="text-5xl text-navy-900 group-hover:text-royal-600">{data.nom}</h2>
          <p class="mt-3 text-lg text-ink/75">{data.resum}</p>
          {data.preu && <p class="mt-4 font-semibold text-navy-900">{data.preu}</p>}
          <span class="mt-6 inline-block font-semibold text-royal-600">Més informació →</span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
