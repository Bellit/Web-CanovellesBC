---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { club } from '../data/club';

const passos = [
  { titol: 'Omple la preinscripció', text: 'Amb el formulari d’aquesta pàgina. Només et demanem les dades bàsiques.' },
  { titol: 'Et truquem', text: 'El coordinador us dirà quin equip us toca, els horaris i quan podeu venir a provar.' },
  { titol: 'Vine a provar', text: 'Unes sessions d’entrenament per conèixer l’equip sense cap compromís.' },
  { titol: 'Formalitza la inscripció', text: 'Fitxa federativa, quota i, si cal, l’equipació del club.' },
];
---

<BaseLayout title="Inscripcions" description={`Com apuntar-se al Canovelles BC la temporada ${club.temporada}: preinscripció, quotes i documentació.`}>
  <PageHeader eyebrow={`Temporada ${club.temporada}`} title="Apunta't al club" intro="Juguis com juguis i tinguis l'edat que tinguis, al Canovelles BC hi ha un lloc per a tu." />

  <section class="container-club py-16">
    <h2 class="text-5xl text-navy-900">Com funciona</h2>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {passos.map(({ titol, text }, i) => (
        <li class="rounded-lg border-t-8 border-gold-500 bg-white p-6 shadow-sm">
          <span class="font-display text-5xl font-extrabold text-royal-600" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-2 text-2xl text-navy-900">{titol}</h3>
          <p class="mt-2 text-ink/75">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-white py-16">
    <div class="container-club grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <h2 class="text-5xl text-navy-900">Quotes i documentació</h2>
        <!-- TODO: afegir quotes i PDFs de la temporada a public/docs/ -->
        <p class="mt-5 text-lg text-ink/80">
          Les quotes i la documentació de la temporada {club.temporada} es publicaran aquí. Mentrestant, escriviu-nos a
          <a href={`mailto:${club.correus.general}`} class="font-semibold text-royal-600 underline">{club.correus.general}</a>.
        </p>
      </div>
      <div class="rounded-lg bg-paper p-6 sm:p-8 lg:col-span-3">
        <h2 class="text-4xl text-navy-900">Preinscripció</h2>
        <div class="mt-6"><ContactForm nom="preinscripcio" preinscripcio /></div>
      </div>
    </div>
  </section>
</BaseLayout>
