---
import { url } from '@/lib/url';
import { club, navegacio } from '../data/club';

const actual = Astro.url.pathname;
const esActiu = (href: string) => actual.startsWith(url(href));
---

<header class="sticky top-0 z-40 border-b-4 border-gold-500 bg-navy-900 text-white">
  <div class="container-club flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href={url('/')} class="flex items-center gap-3" aria-label={`${club.nomCurt}, inici`}>
      <img src={url('/escut.svg')} alt="" width="40" height="45" class="h-10 w-auto lg:h-12" />
      <span class="font-display text-2xl leading-none font-extrabold uppercase lg:text-3xl">
        Canovelles <span class="text-gold-500">BC</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navegacio.map(({ href, label }) => (
          <li>
            <a
              href={url(href)}
              aria-current={esActiu(href) ? 'page' : undefined}
              class="rounded px-3 py-2 font-display text-lg font-semibold tracking-wide uppercase transition hover:text-gold-400 aria-[current=page]:text-gold-500"
            >
              {label}
            </a>
          </li>
        ))}
        <li class="ml-2"><a href={url('/inscripcions/')} class="btn-gold px-5 py-2">Apunta't</a></li>
      </ul>
    </nav>

    <button
      id="menu-boto"
      type="button"
      class="grid size-11 place-items-center rounded lg:hidden"
      aria-controls="menu-mobil"
      aria-expanded="false"
      aria-label="Obre el menú"
    >
      <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="menu-mobil" aria-label="Principal (mòbil)" class="hidden border-t border-white/10 bg-navy-950 lg:hidden">
    <ul class="container-club flex flex-col py-3">
      {navegacio.map(({ href, label }) => (
        <li>
          <a
            href={url(href)}
            aria-current={esActiu(href) ? 'page' : undefined}
            class="block py-3 font-display text-2xl font-semibold uppercase aria-[current=page]:text-gold-500"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-3 pb-2"><a href={url('/inscripcions/')} class="btn-gold w-full">Apunta't al club</a></li>
    </ul>
  </nav>
</header>

<script>
  const boto = document.getElementById('menu-boto');
  const menu = document.getElementById('menu-mobil');
  boto?.addEventListener('click', () => {
    const obert = boto.getAttribute('aria-expanded') === 'true';
    boto.setAttribute('aria-expanded', String(!obert));
    boto.setAttribute('aria-label', obert ? 'Obre el menú' : 'Tanca el menú');
    menu?.classList.toggle('hidden', obert);
  });
</script>
