---
import { valors } from '../data/club';
---

<ol class="grid gap-px overflow-hidden rounded-lg bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
  {valors.map(({ nom, text }, i) => (
    <li class="bg-navy-900 p-7">
      <span class="font-display text-5xl font-extrabold text-gold-500/40" aria-hidden="true">0{i + 1}</span>
      <h3 class="mt-2 text-3xl text-white">{nom}</h3>
      <p class="mt-2 text-white/75">{text}</p>
    </li>
  ))}
</ol>
